generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum OrgType {
  FOUNDER
  BUSINESS
  AGENCY
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AppStatus {
  PENDING
  FILLING
  REVIEW_REQUIRED
  APPROVED
  SUBMITTED
  FAILED
}

enum Plan {
  FREE_TRIAL
  STARTER
  GROWTH
  PRO
  BUSINESS
}

// ─── Core Models ──────────────────────────────────────────

model User {
  id              String               @id @default(cuid())
  supabaseId      String               @unique
  email           String               @unique
  phoneNumber     String?
  whatsappOptIn   Boolean              @default(false)
  whatsappOptInAt DateTime?
  memberships     OrganisationMember[]
  notifications   NotificationLog[]
  communityRedemptions CommunityAccessRedemption[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Organisation {
  id                 String               @id @default(cuid())
  name               String
  type               OrgType              @default(FOUNDER)
  plan               Plan                 @default(FREE_TRIAL)
  stripeId           String?
  communityAccessPlan String?
  communityAccessExpiresAt DateTime?
  communityPartnerSlug String?
  communityAccessCodeId String?
  communityAccessCode CommunityAccessCode? @relation(fields: [communityAccessCodeId], references: [id])
  preferredTimezone  String?              // IANA e.g. Europe/London for 9am local reminders
  members            OrganisationMember[]
  profiles           BusinessProfile[]
  applications       Application[]
  usage              Usage[]
  portalCredentials  PortalCredential[]
  founderFundingPacks FounderFundingPack[]
  applicationOutcomes ApplicationOutcome[]
  communityRedemptions CommunityAccessRedemption[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model CommunityAccessCode {
  id             String   @id @default(cuid())
  partnerName    String
  slug           String   @unique
  tokenHash      String   @unique
  accessPlan     String   @default("GROWTH")
  durationDays   Int      @default(90)
  maxRedemptions Int      @default(250)
  redeemBy       DateTime?
  active         Boolean  @default(true)
  createdBy      String?
  organisations  Organisation[]
  redemptions    CommunityAccessRedemption[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CommunityAccessRedemption {
  id              String   @id @default(cuid())
  codeId          String
  code            CommunityAccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email           String
  accessPlan      String
  accessExpiresAt DateTime
  redeemedAt      DateTime @default(now())

  @@unique([codeId, organisationId])
  @@unique([codeId, userId])
  @@index([codeId])
  @@index([organisationId])
}

model OrganisationMember {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organisationId])
  @@index([organisationId])
}

// ─── Business Data ────────────────────────────────────────

model BusinessProfile {
  id                 String        @id @default(cuid())
  organisationId     String
  organisation       Organisation  @relation(fields: [organisationId], references: [id])
  businessName       String
  businessType       String?              // SME, Startup, Charity / Non-profit, etc. — for grant applicant-type matching
  legalStructure     String?
  businessStage      String?
  businessSizeBand   String?
  founderEmploymentStatus String?
  registrationNumber String?
  sector             String
  missionStatement   String        @db.Text
  description        String        @db.Text
  location           String
  localAuthority     String?
  areasServed        String?       @db.Text
  employeeCount      Int?
  expectedEmployeeGrowth String?    @db.Text
  annualRevenue      Float?
  incorporationDate  String?
  tradingStartDate   String?
  fundingMin         Float         @default(0)
  fundingMax         Float         @default(0)
  fundingPurposes    String[]
  preferredOpportunityTypes String[] @default([])
  fundingDetails     String?       @db.Text
  coFundingCapacity  String?
  reimbursementReadiness String?
  previousGrantExperience String?
  fundingUrgency     String?
  fundingPosition    String?
  documentReadiness  String?
  previousGrantHistory String?    @db.Text
  previousGrants     String?       @db.Text
  funderLocations    String[]      @default([]) // US, UK, EU, Global – which funder regions user wants to see
  websiteUrl         String?
  websiteIntelligence String?      @db.Text     // AI-extracted summary from websiteUrl
  socialImpact       String?       @db.Text     // Social impact track record
  innovationCapabilities String?   @db.Text     // Innovation approach, R&D, IP
  sustainabilityInitiatives String? @db.Text    // Green/ESG initiatives
  communityEngagement String?      @db.Text     // Community partnerships, outreach
  keyAchievements    String?       @db.Text     // Awards, milestones, growth metrics
  teamExpertise      String?       @db.Text     // Key team skills, qualifications
  eligibilityFacts   Json?         @default("[]") // Confirmed edge-case eligibility facts: property ownership, match funding, certifications, etc.
  documents          Document[]
  applications       Application[]
  founderFundingPacks FounderFundingPack[]
  applicationOutcomes ApplicationOutcome[]
  completionScore    Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model FounderFundingPack {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  profileId      String
  profile        BusinessProfile @relation(fields: [profileId], references: [id])
  createdById    String?
  type           String          @default("innovator_founder_visa")
  status         String          @default("generated")
  inputs         Json            @default("{}")
  content        Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organisationId])
  @@index([profileId])
}

model Document {
  id        String          @id @default(cuid())
  profileId String
  profile   BusinessProfile @relation(fields: [profileId], references: [id])
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime        @default(now())
}

model Grant {
  id               String        @id @default(cuid())
  externalId       String?       @unique
  name             String
  funder           String
  amount           Float?
  deadline         DateTime?
  applicationUrl  String
  detailUrl        String?
  directApplicationUrl String?
  applicationUrlKind String        @default("unknown")
  applicationUrlQuality String     @default("unknown")
  applicationUrlConfidence Int     @default(0)
  applicationUrlVerifiedAt DateTime?
  applicationUrlQualityReason String?
  eligibility      String        @db.Text
  description      String?       @db.Text    // Full programme description / synopsis
  objectives       String?       @db.Text    // What the grant aims to fund
  applicantTypes   String[]      @default([]) // e.g. SME, Non-profit, Public Sector
  sectors          String[]
  regions          String[]
  funderLocations  String[]      @default([]) // US, UK, EU, Global – which regions this funder serves
  source           String?                    // default, claude, openai, gemini, perplexity, grants-gov, bing, google, admin
  url_status       String        @default("unknown") // live, dead, expired, unknown
  url_checked_at   DateTime?     // last time the URL was verified
  opportunityType  String?
  fundingValueType String?
  applicantMaxAmount Float?
  applicantTypicalAmount Float?
  programmeTotalAmount Float?
  fundingValueEvidence String?    @db.Text
  applications    Application[]
  applicationOutcomes ApplicationOutcome[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

/// Key/value settings for Fly.io worker (scout_mode). See supabase/migrations/034_worker_settings.sql.
model WorkerSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("worker_settings")
}

model Application {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  createdById    String
  grantId        String
  grant          Grant           @relation(fields: [grantId], references: [id])
  profileId      String
  profile        BusinessProfile @relation(fields: [profileId], references: [id])
  focusNotes     String?         @db.Text     // User notes guiding AI for this specific grant
  status         AppStatus       @default(PENDING)
  submittedAt    DateTime?
  outcome        ApplicationOutcome?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organisationId])
}

model ApplicationOutcome {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  applicationId  String          @unique
  application    Application     @relation(fields: [applicationId], references: [id])
  grantId        String
  grant          Grant           @relation(fields: [grantId], references: [id])
  profileId      String
  profile        BusinessProfile @relation(fields: [profileId], references: [id])
  reportedById   String?
  outcome        String
  awardedAmount  Float?
  funderFeedback String?         @db.Text
  responseText   String?         @db.Text
  responseScreenshotName String?
  responseScreenshotDataUrl String? @db.Text
  learningNotes  String?         @db.Text
  reportedAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organisationId])
  @@index([grantId])
  @@index([profileId])
}

model Usage {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  type           String
  units          Int
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String
  type      String
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model RecommendationFeedback {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  profileId      String?  @map("profile_id")
  grantId        String   @map("grant_id")
  userId         String?  @map("user_id")
  category       String
  note           String?  @db.Text
  source         String   @default("card")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId])
  @@index([profileId])
  @@index([grantId])
  @@map("RecommendationFeedback")
}

model PortalCredential {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  portalHost        String
  portalName        String
  username          String
  encryptedPassword String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organisationId, portalHost])
  @@index([organisationId])
}
